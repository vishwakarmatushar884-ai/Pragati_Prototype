# ==============================================================================
# PRAGATI Enterprise Deployment Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust the values according to your environment.
# Note: In production, generate strong, random secrets.

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & PROFILES
# ------------------------------------------------------------------------------
APP_ENV=production
SPRING_PROFILES_ACTIVE=prod
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pragati_db
POSTGRES_USER=pragati_user
POSTGRES_PASSWORD=pragati_secure_password_change_in_prod

# JDBC URL used by Spring Boot
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/pragati_db
SPRING_DATASOURCE_USERNAME=pragati_user
SPRING_DATASOURCE_PASSWORD=pragati_secure_password_change_in_prod

# Connection Pool Settings (HikariCP)
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_TIMEOUT=30000

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Minimum 32-character HMAC-SHA256 secret key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Allowed CORS origins (comma-separated or wildcard for dev)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80,https://pragati.gov.in

# Whether to seed initial demo data if database is empty (true/false)
APP_SEED_ENABLED=true

# ------------------------------------------------------------------------------
# 4. MICROSERVICES CONNECTIVITY
# ------------------------------------------------------------------------------
ML_SERVICE_HOST=ml-service
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://ml-service:8000

BACKEND_HOST=backend
BACKEND_PORT=8080
BACKEND_URL=http://backend:8080

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_URL=/api
FRONTEND_PORT=80
FRONTEND_DEV_PORT=5173

# ------------------------------------------------------------------------------
# 6. DOMAIN & SSL CONFIGURATION (For Production Nginx Reverse Proxy)
# ------------------------------------------------------------------------------
DOMAIN_NAME=pragati.gov.in
SSL_EMAIL=admin@pragati.gov.in
ENABLE_SSL=false
HTTP_PORT=80
HTTPS_PORT=443
